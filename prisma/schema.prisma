generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model apps {
  id           Int     @id @default(autoincrement()) @db.UnsignedInt
  name         String? @db.Char(60)
  filename     String? @db.Char(60)
  filedate     Int?
  timestamp    Int?
  author       String? @db.Char(60)
  filesize     Int?
  file_id      String? @db.Char(60)
  view_counter Int?
  downloads    Int?
  uploader     String? @db.Char(60)
  uploader_id  Int?    @db.UnsignedInt
  file_id_date Int?
  Status       String? @db.Char(7)
  year         Int     @default(0)
  month        Int     @default(0)
  day          Int     @default(0)

  @@index([uploader_id], map: "uploader_id")
  @@fulltext([author], map: "author")
  @@fulltext([filename], map: "filename")
  @@fulltext([name], map: "name")
  @@fulltext([uploader], map: "uploader")
}

model artists {
  id             Int              @id @default(autoincrement()) @db.UnsignedInt
  nick           String           @unique(map: "nick") @default("") @db.Char(60)
  www            String?          @db.Char(60)
  active         String?          @db.Char(8)
  country        String?          @db.Char(60)
  rating         Float?           @db.Float
  acronym        String?          @db.Char(16)
  user_id        Int?             @db.UnsignedInt
  artisturl      String           @db.Char(60)
  users          users?           @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "artists_ibfk_1")
  artists_collys artists_collys[]

  @@index([artisturl], map: "artisturl")
  @@index([user_id], map: "user_id")
  @@fulltext([nick], map: "fts_nick")
}

model artists_collys {
  id        Int     @id @default(autoincrement()) @db.UnsignedInt
  artist_id Int     @db.UnsignedInt
  colly_id  Int     @db.UnsignedInt
  sortorder Int     @default(0) @db.TinyInt
  updated   String? @db.VarChar(1)
  artists   artists @relation(fields: [artist_id], references: [id], onDelete: Cascade, map: "artists_collys_ibfk_1")
  collys    collys  @relation(fields: [colly_id], references: [id], onDelete: Cascade, map: "artists_collys_ibfk_2")

  @@unique([artist_id, colly_id], map: "artist_id")
  @@index([colly_id], map: "colly_id")
}

model auth {
  selector   String   @unique(map: "a_selector") @db.VarChar(16)
  hash       String   @db.VarChar(64)
  user_id    Int      @unique(map: "a_user_id")
  expiration DateTime @db.DateTime(0)
}

model bbs_of {
  name    String? @db.Char(60)
  crew    String? @db.Char(60)
  id      Int     @id @default(autoincrement()) @db.UnsignedInt
  updated String? @db.VarChar(1)

  @@index([crew], map: "crew")
  @@index([name], map: "name")
}

model bbses {
  name     String? @db.Char(60)
  sysop    String? @db.Char(60)
  address  String? @db.Char(60)
  number   String? @db.Char(24)
  id       Int     @id @default(autoincrement()) @db.UnsignedInt
  country  String? @db.VarChar(60)
  online   Boolean @default(false)
  software String? @db.VarChar(30)
}

model collys {
  id             Int              @id @default(autoincrement()) @db.UnsignedInt
  name           String?          @db.Char(128)
  year           Int?
  type           String?          @db.Char(11)
  filename       String           @unique(map: "filename") @default("") @db.Char(60)
  timestamp      Int?
  rating         Float?           @db.Float
  uploader       String?          @db.Char(32)
  uploader_id    Int?             @db.UnsignedInt
  filesize       Int?
  month          Int?
  file_id        String?          @db.Char(60)
  view_counter   Int?
  downloads      Int?
  day            Int?
  broken         Int?
  broken_comment String?          @db.MediumText
  render_font    String?          @db.Char(32)
  render_fg      String?          @db.Char(15)
  render_bg      String?          @db.Char(15)
  soundtrack     String?          @db.Char(255)
  artists_collys artists_collys[]
  collys_crews   collys_crews[]

  @@index([uploader_id], map: "uploader_id")
  @@fulltext([name, filename], map: "name")
}

model collys_crews {
  id        Int     @id @default(autoincrement()) @db.UnsignedInt
  colly_id  Int     @db.UnsignedInt
  crew_id   Int     @db.UnsignedInt
  sortorder Int     @default(0) @db.TinyInt
  updated   String? @db.VarChar(1)
  collys    collys  @relation(fields: [colly_id], references: [id], onDelete: Cascade, map: "collys_crews_ibfk_1")
  crews     crews   @relation(fields: [crew_id], references: [id], onDelete: Cascade, map: "collys_crews_ibfk_2")

  @@unique([colly_id, crew_id], map: "colly_id")
  @@index([crew_id], map: "crew_id")
}

model comments {
  commentid Int     @id @default(autoincrement())
  colly_id  Int?    @db.UnsignedInt
  filename  String? @db.Char(60)
  crew      String? @db.Char(60)
  artist    String? @db.Char(60)
  comment   String? @db.MediumText
  rating    Int?
  nick      String? @db.Char(60)
  timestamp Int?
  base64    Int?
  user_id   Int?    @db.UnsignedInt

  @@index([colly_id], map: "colly_id")
  @@index([user_id], map: "user_id")
}

model crews {
  id           Int            @id @default(autoincrement()) @db.UnsignedInt
  name         String         @unique(map: "name") @db.Char(60)
  www          String?        @db.Char(60)
  contact      String?        @db.Char(60)
  active       String         @default("No") @db.Char(8)
  rating       Float?         @db.Float
  acronym      String?        @db.Char(12)
  crewurl      String         @db.Text
  collys_crews collys_crews[]

  @@fulltext([name], map: "fts_crewname")
  @@fulltext([name, acronym], map: "ftx_crews")
}

model favourites {
  id       Int     @id @default(autoincrement()) @db.UnsignedInt
  user_id  Int?    @db.UnsignedInt
  colly_id Int?    @db.UnsignedInt
  nick     String? @db.Char(60)
  filename String? @db.Char(60)

  @@index([colly_id], map: "colly_id")
  @@index([user_id], map: "user_id")
}

model hippo_playlists {
  id         Int    @id @default(autoincrement())
  title      String @db.VarChar(200)
  author     String @db.VarChar(100)
  genre      String @db.VarChar(100)
  filedata   String @db.MediumText
  filename   String @db.VarChar(200)
  uploaddate Int
}

model lastusers {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  user_id   Int?   @db.UnsignedInt
  nick      String @db.Char(60)
  crew      String @db.Char(60)
  timestamp Int

  @@index([user_id], map: "user_id")
}

model logos {
  logo_id  Int        @id @default(autoincrement())
  author   String?    @db.Char(60)
  ascii    String     @db.MediumText
  base64   Int?
  kind     logos_kind @default(ascii)
  ansi_b64 String?    @db.MediumText
  font     String?    @db.VarChar(32)
}

enum logos_kind {
  ascii
  ansi
}

// One row per detected logo inside a colly, keyed by its extracted plaintext
// label (from dividers / index sections). Stores labels only — NOT colly art.
// Powers "search logos in collys", per-entity logo listings, and stats.
model colly_logos {
  id         Int     @id @default(autoincrement()) @db.UnsignedInt
  colly_id   Int     @db.UnsignedInt
  position   Int // 0-based index of the logo within the colly
  start_line Int // line offset, for scroll-to/deep-link
  end_line   Int? // 0-based end line of the logo (manual maps); null = auto-detected
  manual     Int     @default(0) // 1 = artist-mapped in the editor (drives rendering)
  label      String  @db.Char(120)
  label_norm String  @db.Char(120)
  artist_id  Int?    @db.UnsignedInt
  crew_id    Int?    @db.UnsignedInt
  user_id    Int?    @db.UnsignedInt

  @@index([colly_id])
  @@index([artist_id])
  @@index([crew_id])
  @@index([user_id])
  @@index([label_norm])
  @@fulltext([label], map: "ft_colly_logo_label")
}

model mags {
  id           Int     @id @default(autoincrement())
  name         String? @db.Char(60)
  filename     String? @unique(map: "filename") @db.Char(60)
  filedate     Int?
  timestamp    Int?
  author       String? @db.Char(60)
  filesize     Int?
  file_id      String? @db.Char(60)
  view_counter Int?
  downloads    Int?
  uploader     String? @db.Char(60)
  year         Int     @default(0) @db.MediumInt
  month        Int     @default(0)
  day          Int     @default(0)
}

model member_of {
  id      Int     @id @default(autoincrement()) @db.UnsignedInt
  crew    String  @db.Char(60)
  nick    String  @db.Char(60)
  updated String? @db.VarChar(1)

  @@fulltext([crew], map: "fts_membercrew")
  @@fulltext([nick], map: "fts_membernick")
}

model messages {
  id                            Int     @id @default(autoincrement()) @db.UnsignedInt
  thread                        Int?
  from_id                       Int?    @db.UnsignedInt
  to_id                         Int?    @db.UnsignedInt
  postedto                      String? @db.Char(60)
  postername                    String? @db.Char(60)
  timestamp                     Int?
  subject                       String? @db.VarChar(128)
  message                       String? @db.MediumText
  new                           Int?
  unread                        Boolean @default(false)
  attach_filename               String? @db.VarChar(100)
  attach_filedata               String? @db.MediumText
  users_messages_from_idTousers users?  @relation("messages_from_idTousers", fields: [from_id], references: [id], onDelete: Cascade, map: "messages_ibfk_1")
  users_messages_to_idTousers   users?  @relation("messages_to_idTousers", fields: [to_id], references: [id], onDelete: Cascade, map: "messages_ibfk_2")

  @@index([from_id], map: "from_id")
  @@index([to_id], map: "to_id")
}

model chat_participants {
  id           Int     @id @default(autoincrement()) @db.UnsignedInt
  thread_id    Int     @db.UnsignedInt
  user_id      Int     @db.UnsignedInt
  joined_at    Int
  left_at      Int?
  last_read_at Int     @default(0)
  title        String? @db.VarChar(128)

  @@unique([thread_id, user_id], map: "uq_thread_user")
  @@index([thread_id], map: "idx_thread")
  @@index([user_id], map: "idx_user")
}

model request_comments {
  comment_id      Int     @id @default(autoincrement())
  request_id      Int
  user_id         Int
  comment         String  @db.MediumText
  attach_filename String? @db.VarChar(100)
  attach_filedata String? @db.MediumText
  timestamp       Int
}

model requests {
  id          Int    @id @default(autoincrement())
  title       String @db.VarChar(255)
  description String @db.Text
  status      Int    @default(0)
  requestedby Int
  timestamp   Int
}

model styles {
  id       Int  @id @default(autoincrement())
  name     String @db.MediumText
  user     String @db.MediumText
  user_ids Int
  style    String @db.MediumText
  status   Int
  group_id Int?   @db.UnsignedInt
}

model font_groups {
  id         Int                  @id @default(autoincrement()) @db.UnsignedInt
  name       String               @db.VarChar(64)
  owner_id   Int                  @db.UnsignedInt
  created_at Int
  members    font_group_members[]
}

model font_group_members {
  id       Int         @id @default(autoincrement()) @db.UnsignedInt
  group_id Int         @db.UnsignedInt
  user_id  Int         @db.UnsignedInt
  group    font_groups @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([group_id, user_id])
}

model users {
  id                               Int               @id @default(autoincrement()) @db.UnsignedInt
  nick                             String            @unique(map: "nick") @db.Char(60)
  crew                             String?           @db.Char(60)
  password                         String?           @db.Char(60)
  pwhash                           String?           @db.Char(128)
  lastactive                       Int?
  current                          String            @db.VarChar(255)
  byear                            Int?
  bmonth                           Int?
  bday                             Int?
  country                          String?           @db.VarChar(60)
  mail                             String?           @db.Char(60)
  webpage                          String?           @db.Char(60)
  uploaded                         Int
  rank                             String?           @db.Char(16)
  joined                           String?           @db.Char(11)
  def_bg_col                       String?           @db.Char(15)
  def_fg_col                       String?           @db.Char(15)
  upload_signature                 String            @default("- -- - aSCIIaRENa - ---- - aSCIIaRENa - -- -") @db.VarChar(80)
  list_view_mode                   String?           @default("standard") @db.Char(8)
  display_mail                     String?           @db.Char(3)
  temp_pw_hash                     String?           @db.Char(60)
  def_font                         String?           @db.Char(32)
  nickurl                          String            @db.Char(60)
  crt_effect                       users_crt_effect  @default(N)
  anim_effect                      users_anim_effect @default(N)
  // Comma-separated list of activity-feed event types the user has opted out
  // of broadcasting. Examples of types: "wall", "upload", "request", "view",
  // "comment". NULL or "" means everything is broadcast as normal. Stored as
  // text rather than a boolean per type so future event types don't require
  // a schema change.
  activity_hidden_types            String?           @db.VarChar(255)
  // Comma-separated list of widget keys the user wants hidden from their
  // own view. See lib/widgets-types.ts for the canonical key list. NULL
  // means show all widgets (the default).
  hidden_widgets                   String?           @db.VarChar(500)
  artists                          artists[]
  messages_messages_from_idTousers messages[]        @relation("messages_from_idTousers")
  messages_messages_to_idTousers   messages[]        @relation("messages_to_idTousers")
  wallposts                        wallposts[]

  @@index([nickurl], map: "nickurl")
}

model notifications {
  id          Int      @id @default(autoincrement())
  user_id     Int      @db.UnsignedInt
  type        String   @db.VarChar(32)
  actor_nick  String?  @db.VarChar(64)
  target      String?  @db.VarChar(255)
  target_url  String?  @db.VarChar(512)
  payload     Json?
  read_at     Int?
  created_at  Int

  @@index([user_id, read_at, created_at], map: "ix_user_unread")
}

model users_online {
  id        BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  timestamp Int
  session   String? @db.VarChar(128)
  current   String  @db.VarChar(255)
}

model wall {
  id      Int      @id @default(autoincrement())
  nick    String?  @db.Char(60)
  tag     String?  @db.Char(128)
  created DateTime @default(now()) @db.Timestamp(0)
}

model wallposts {
  id      Int      @id @default(autoincrement()) @db.UnsignedInt
  wall_id Int?     @db.UnsignedInt
  user_id Int?     @db.UnsignedInt
  tag     String   @db.VarChar(255)
  nick    String   @db.VarChar(255)
  created DateTime @default(now()) @db.Timestamp(0)
  walls   walls?   @relation(fields: [wall_id], references: [id], onDelete: Cascade, map: "wallposts_ibfk_1")
  users   users?   @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "wallposts_ibfk_2")

  @@index([user_id], map: "user_id")
  @@index([wall_id], map: "wall_id")
}

model walls {
  id          Int         @id @default(autoincrement()) @db.UnsignedInt
  name        String      @db.VarChar(64)
  description String      @db.VarChar(255)
  user_id     Int?        @db.UnsignedInt
  wallposts   wallposts[]

  @@index([user_id], map: "user_id")
}

enum users_crt_effect {
  Y
  N
}

enum users_anim_effect {
  Y
  N
}

model polls {
  id            Int                  @id @default(autoincrement()) @db.UnsignedInt
  slug          String               @unique(map: "uq_slug") @db.VarChar(96)
  title         String               @db.VarChar(255)
  body          String               @db.MediumText
  type          polls_type
  status        polls_status         @default(draft)
  featured      Boolean              @default(false)
  created_by_id Int                  @db.UnsignedInt
  opens_at      Int?
  closes_at     Int?
  config        Json?
  show_results  polls_show_results   @default(always)
  result_layout polls_result_layout  @default(tail)
  created_at    Int
  updated_at    Int
  options       poll_options[]
  votes         poll_votes[]

  @@index([status, featured], map: "ix_status_featured")
  @@index([created_by_id], map: "ix_creator")
}

model poll_options {
  id            Int          @id @default(autoincrement()) @db.UnsignedInt
  poll_id       Int          @db.UnsignedInt
  label         String       @db.VarChar(255)
  color_idx     Int          @default(7) @db.TinyInt
  sort_order    Int          @default(0)
  created_by_id Int?         @db.UnsignedInt
  approved      Boolean      @default(true)
  polls         polls        @relation(fields: [poll_id], references: [id], onDelete: Cascade, map: "poll_options_ibfk_1")
  votes         poll_votes[]

  @@index([poll_id], map: "ix_poll")
}

model poll_votes {
  id          Int          @id @default(autoincrement()) @db.UnsignedInt
  poll_id     Int          @db.UnsignedInt
  user_id     Int          @db.UnsignedInt
  option_id   Int          @db.UnsignedInt
  vote_value  Int?
  created_at  Int
  updated_at  Int
  polls       polls        @relation(fields: [poll_id], references: [id], onDelete: Cascade, map: "poll_votes_ibfk_1")
  options     poll_options @relation(fields: [option_id], references: [id], onDelete: Cascade, map: "poll_votes_ibfk_2")

  @@unique([poll_id, user_id, option_id], map: "uq_poll_user_option")
  @@index([poll_id], map: "ix_poll")
  @@index([user_id], map: "ix_user")
}

enum polls_type {
  single
  multi
  yesno
  rating
  ranked
  approval
  text_suggest
}

enum polls_status {
  draft
  open
  closed
}

enum polls_show_results {
  always
  after_vote
  after_close
}

enum polls_result_layout {
  solid
  tail
  dual_row
}
