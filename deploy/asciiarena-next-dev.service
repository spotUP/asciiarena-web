[Unit]
Description=ASCIIaRENA Next.js App (DEV)
After=network.target

[Service]
# KillMode=mixed sends SIGTERM to the main process only and SIGKILL straight
# to the worker children, so the open SSE connections in app/api/live can't
# stall the cgroup shutdown. TimeoutStopSec caps the wait at 10s before
# systemd force-kills — without these two settings the default 90s timeout
# applies and every deploy serves Apache a 503 for a minute and a half.
KillMode=mixed
TimeoutStopSec=10
Type=simple
User=spot
WorkingDirectory=/var/www/asciiarena.se/nextjs-dev
EnvironmentFile=/var/www/asciiarena.se/nextjs-dev/.env
Environment=NODE_ENV=production
Environment=PORT=3003
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/local/bin/node server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
