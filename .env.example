# Copy to .env and fill in values before deploying

# Database (MariaDB/MySQL)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/uprough_ascii"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="https://asciiarena.se"

# File storage paths on the server
COLLECTIONS_PATH="/var/www/asciiarena.se/collections"
APPS_PATH="/var/www/asciiarena.se/apps"
MAGS_PATH="/var/www/asciiarena.se/mags"

# Discord webhooks (optional — notifications on new uploads/requests)
DISCORD_UPLOAD_WEBHOOK=""
DISCORD_REQUEST_WEBHOOK=""

# Mail (Nodemailer — for registration emails)
MAILROOT="asciiarenamailer@gmail.com"
MAILHOST="smtp.gmail.com"
MAILPORT="465"
MAILUSER="asciiarenamailer@gmail.com"
MAILPASS=""
